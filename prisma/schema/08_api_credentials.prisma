enum ApiIntegrationState {
  ACTIVE
  ARCHIVED
}

model ApiIntegration {
  id      String              @id @default(uuid())
  name    String
  nameKey String              @unique
  purpose String
  state   ApiIntegrationState @default(ACTIVE)

  createdByUserId  String
  updatedByUserId  String
  archivedByUserId String?
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  createdByUser  User            @relation("ApiIntegrationCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser  User            @relation("ApiIntegrationUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  archivedByUser User?           @relation("ApiIntegrationArchivedByUser", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  credentials    ApiCredential[]

  @@index([state, createdAt])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([archivedByUserId])
}

model ApiCredential {
  id            String   @id @default(uuid())
  integrationId String
  label         String
  prefix        String   @unique
  verifier      String
  scopes        String[]
  expiresAt     DateTime

  createdByUserId String
  revokedByUserId String?
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  integration   ApiIntegration @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  createdByUser User           @relation("ApiCredentialCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedByUser User?          @relation("ApiCredentialRevokedByUser", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([integrationId, createdAt])
  @@index([createdByUserId])
  @@index([revokedByUserId])
  @@index([expiresAt])
}
